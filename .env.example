# Copy this file to .env for local development (never commit the real .env).
# All variables are read via os.environ — see app/config.py.

# --- Flask ---
FLASK_ENV=development
FLASK_SECRET_KEY=change-me-to-a-random-string

# --- MCP transport ---
# "inprocess" (default): agent calls the MCP tool registry directly in this
#   same process — no second service needed, ideal for local dev and the
#   free-tier single-service deployment mode.
# "http": agent calls a separately deployed MCP server over HTTP.
MCP_TRANSPORT=inprocess
MCP_SERVER_URL=http://localhost:8001
# Whether to also mount the MCP HTTP endpoints (/mcp/rpc, /mcp/health)
# inside this same Flask app (useful even in inprocess mode, so you can
# smoke-test the HTTP surface locally before deploying it separately).
MOUNT_MCP_IN_APP=true

# --- LLM (optional) ---
# Leave LLM_API_KEY unset to run in fully offline / zero-cost mode: the
# agent still retrieves, calls tools, and synthesizes grounded, cited
# answers using a deterministic template instead of an LLM rewrite.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20

# --- Misc ---
MAX_MESSAGE_LENGTH=2000
RATE_LIMIT_PER_MINUTE=30
PORT=8000
